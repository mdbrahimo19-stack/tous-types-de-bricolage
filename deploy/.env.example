# Réglages de PRODUCTION. Copier en .env (même dossier) et remplir.
# Ne jamais mettre le fichier .env sur GitHub.

# --- Adresse publique ---------------------------------------------------
# Sans nom de domaine : IP du VPS en tirets + .sslip.io (ex. 51-15-20-30.sslip.io)
# Avec un domaine : api.mondomaine.com (créer d'abord l'enregistrement DNS A vers l'IP du VPS)
DOMAIN=51-15-20-30.sslip.io

# --- Django --------------------------------------------------------------
DJANGO_DEBUG=False
# clé longue et aléatoire : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=51-15-20-30.sslip.io
CSRF_TRUSTED_ORIGINS=https://51-15-20-30.sslip.io

# --- Base PostgreSQL (créée automatiquement au premier démarrage) --------
POSTGRES_DB=ttb
POSTGRES_USER=ttb
# mot de passe long et aléatoire
POSTGRES_PASSWORD=

# --- SMS (codes de connexion) — voir docs/sms-aggregator-brief.md --------
# console = aucun SMS envoyé (codes visibles dans `docker compose logs web`)
SMS_BACKEND=console
SMS_API_URL=
SMS_API_KEY=
SMS_AUTH_HEADER=Authorization
SMS_AUTH_SCHEME=Bearer
SMS_SENDER_ID=TTB
SMS_PHONE_FORMAT=e164
SMS_FIELD_TO=to
SMS_FIELD_TEXT=text
SMS_FIELD_SENDER=sender
SMS_EXTRA_JSON={}

# --- IA (facultatif) -----------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
