# Copie ce fichier en .env et adapte les valeurs.

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Dev: laisse vide -> SQLite. Prod: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# console = affiche l'OTP dans la console (dev)
# firebase = vérifie un ID token Firebase envoyé par le client (voir docs/firebase-phone-auth-test.md)
SMS_BACKEND=console
OTP_TTL_SECONDS=300

# Renseigner seulement si SMS_BACKEND=firebase
FIREBASE_CREDENTIALS_FILE=

CORS_ALLOWED_ORIGINS=
