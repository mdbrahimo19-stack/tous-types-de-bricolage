# Copie ce fichier en .env et adapte les valeurs.

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
# 10.0.2.2 = PC vu depuis l'émulateur Android ; ajouter aussi l'IP locale du PC pour un vrai téléphone
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Dev: laisse vide -> SQLite. Prod: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# console = affiche l'OTP dans la console (dev, aucun SMS envoyé)
# http    = envoie le SMS via l'API d'un fournisseur (voir docs/sms-aggregator-brief.md)
SMS_BACKEND=console
OTP_TTL_SECONDS=300

# Renseigner seulement si SMS_BACKEND=http (valeurs données par le fournisseur)
SMS_API_URL=
SMS_API_KEY=
SMS_AUTH_HEADER=Authorization
SMS_AUTH_SCHEME=Bearer
SMS_SENDER_ID=TTB
# format du numéro attendu : e164 (+213555…) | intl (213555…) | local (0555…)
SMS_PHONE_FORMAT=e164
# noms des champs JSON attendus par le fournisseur
SMS_FIELD_TO=to
SMS_FIELD_TEXT=text
SMS_FIELD_SENDER=sender
# champs fixes en plus, en JSON (ex. {"type": "otp"})
SMS_EXTRA_JSON={}
SMS_TIMEOUT_SECONDS=10

# Renseigner seulement si SMS_BACKEND=firebase
FIREBASE_CREDENTIALS_FILE=

CORS_ALLOWED_ORIGINS=

# IA (Claude) - clé sur https://platform.claude.com ; vide -> IA désactivée
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
